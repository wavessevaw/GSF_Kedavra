+		           + textureLod(s_samplers[slot], p12, 0.0) * wm
+		           + textureLod(s_samplers[slot], hi, 0.0) * wh) / (wl + wm + wh);
+		return (u_flags & KFG_FLAG_SCRGB) != 0 ? axis : max(axis, vec4(0.0));
+	}
 	vec4 r = textureLod(s_samplers[slot], vec2(p12.x, p0.y), 0.0) * (w12.x * w0.y)
