+	// The caller already bypasses this function when both coordinates are integral.
+	if (f.x == 0.0 || f.y == 0.0) {
+		vec2 lo = f.x == 0.0 ? vec2(p12.x, p0.y) : vec2(p0.x, p12.y);
+		vec2 hi = f.x == 0.0 ? vec2(p12.x, p3.y) : vec2(p3.x, p12.y);
+		float wl = f.x == 0.0 ? w0.y : w0.x;
