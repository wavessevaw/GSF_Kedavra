+int wlserver_exchange_virtual_size(size_t index, int fromW, int fromH, int toW, int toH)
+{
+	assert(wlserver_is_lock_held());
+	auto *server = wlserver_get_xwayland_server(index);
+	if (!index || !server) return 0;
+	auto *output = server->get_output();
+	if (output->width != fromW || output->height != fromH) return 0;
+	wlr_output_state state;
+	wlr_output_state_init(&state);
+	wlr_output_state_set_custom_mode(&state, toW, toH, output->refresh);
+	bool ok = wlr_output_commit_state(output, &state);
+	wlr_output_state_finish(&state);
+	return ok ? 1 : -1;
+}
