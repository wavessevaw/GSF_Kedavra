@@ -1092,6 +1092,49 @@ global_focus_t *GetFocusForWindow( steamcompmgr_win_t *w )
 }
 
 uint32_t		currentOutputWidth, currentOutputHeight;
+// SteamOS normally keeps the client on Xwayland 0 and the game on 1.
+// A launch notification arms one transaction on an empty game display.
+// No Steam property, physical mode, or game configuration is persisted.
+struct SrVirtualMode {
+	uint32_t app = 0, launch = 0;
+	int width = 0, height = 0, originalWidth = 0, originalHeight = 0;
+};
+static SrVirtualMode srMode;
+static uint32_t srLastLaunch;
+static void UpdateSrDisplay()
+{
+	auto req = kfg::SuperResolutionRequest();
+	if (!req.app && !srMode.app) return;
+	auto *server = wlserver_get_xwayland_server(1);
+	if (!server || !server->ctx) { srMode = {}; return; }
+	if (srMode.app && (srMode.app != req.app || !req.app ||
+	    srMode.originalWidth != int(currentOutputWidth) || srMode.originalHeight != int(currentOutputHeight))) {
+		wlserver_lock();
+		int rc = wlserver_exchange_virtual_size(1, srMode.width, srMode.height,
+		                                       srMode.originalWidth, srMode.originalHeight);
+		wlserver_unlock();
+		if (rc >= 0) srMode = {}; // An external change supersedes our receipt.
+		return;
+	}
+	if (srMode.app || !req.launch || req.launch == srLastLaunch || req.height >= 800) return;
+	srLastLaunch = req.launch;
+	// Skip multi-seat layouts and dedicated dynamically allocated servers.
+	if (g_nXWaylandCount != 2 || wlserver_get_xwayland_server(2) || !GetBackend()->GetCurrentConnector())
+		return;
+	for (auto *w = server->ctx->list; w; w = w->xwayland().next)
+		if (w->xwayland().a.map_state == IsViewable && w->xwayland().a.c_class == InputOutput &&
+		    w->xwayland().a.width > 1 && w->xwayland().a.height > 1)
+			return;
+	int ow = currentOutputWidth, oh = currentOutputHeight;
+	if (ow < 640 || oh < 480 || ow > 7680 || oh > 4320) return;
+	int width = 2 * ((ow * int(req.height) + 800) / 1600);
+	int height = 2 * ((oh * int(req.height) + 800) / 1600);
+	wlserver_lock();
+	int rc = wlserver_exchange_virtual_size(1, ow, oh, width, height);
+	wlserver_unlock();
+	if (rc == 1) srMode = {req.app, req.launch, width, height, ow, oh};
+}
