// SPDX-License-Identifier: GPL-3.0-or-later
// Full-resolution synthesis of one generated frame at phase u_t.
// Slots: 0 = colour A, 1 = colour B, 2 = selected motion (4x4 blocks), 3 = stats.
// Colour is interpolated in the source's stored encoding (sRGB, PQ or linear scRGB).
#version 450
#extension GL_GOOGLE_include_directive : require
#include "kfg_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;



// Catmull-Rom resampling in 5 bilinear taps (the four corner taps dropped). Bilinear softens
// every fractional position, so generated frames came out blurrier than the real ones around
// them and fine texture pulsed at the generation cadence during slow turns.
vec4 tap_sharp(int slot, vec2 pos, ivec2 size)
{
	vec2 tc = pos + 0.5;
	vec2 c = floor(tc - 0.5) + 0.5;
	vec2 f = tc - c;
	vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
	vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
	vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
	vec2 w3 = f * f * (-0.5 + 0.5 * f);
	vec2 w12 = w1 + w2;
	vec2 o12 = w2 / w12;
	vec2 inv = 1.0 / vec2(size);
	vec2 p0 = (c - 1.0) * inv, p3 = (c + 2.0) * inv, p12 = (c + o12) * inv;
	vec4 r = textureLod(s_samplers[slot], vec2(p12.x, p0.y), 0.0) * (w12.x * w0.y)
	       + textureLod(s_samplers[slot], vec2(p0.x, p12.y), 0.0) * (w0.x * w12.y)
	       + textureLod(s_samplers[slot], p12, 0.0) * (w12.x * w12.y)
	       + textureLod(s_samplers[slot], vec2(p3.x, p12.y), 0.0) * (w3.x * w12.y)
	       + textureLod(s_samplers[slot], vec2(p12.x, p3.y), 0.0) * (w12.x * w3.y);
	float wsum = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
	r /= wsum;
	// Catmull-Rom overshoots below zero at edges. scRGB keeps negative values: they are
	// colours outside BT.709, not overshoot, and clamping them would shift wide-gamut colour.
	return (u_flags & KFG_FLAG_SCRGB) != 0 ? r : max(r, vec4(0.0));
}

// Distance to the last valid texel centre (not the texture's outer edge).
float edge_distance(vec2 p, ivec2 size)
{
	vec2 d = min(p, vec2(size - 1) - p);
	return min(d.x, d.y);
}

void main()
{
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(p, u_dstSize)))
		return;
	ivec2 size = u_fullSize;
	vec4 stats = texelFetch(s_samplers[3], ivec2(0), 0);
	if (stats.x > 0.5) {
		// Scene cut: never blend two unrelated images.
		vec4 c = u_t < 0.5 ? texelFetch(s_samplers[0], p, 0) : texelFetch(s_samplers[1], p, 0);
		imageStore(dst, p, vec4(c.rgb, 1.0));
		return;
	}
	// The field and its vectors are in analysis pixels: the source's own up to the Deck's
	// pixel count, scaled down above it (u_scale source pixels per analysis pixel).
	const vec2 sc = u_scale;
	ivec2 bsize = (u_srcSize + 3) / 4;
	// Bilinear footprint over the block field; use it only where the four vectors agree.
	vec2 bp = (vec2(p) + 0.5) / sc * 0.25 - 0.5;
	const bool pair = (u_flags & KFG_FLAG_PAIR) != 0;
	if (pair && u_t != 0.5) {
		// The pair's field holds the motion of what is at each block at mid-phase; at phase
		// t that content has moved on by (t - 0.5) v. Look up where this pixel's content was.
		vec2 v0 = texelFetch(s_samplers[2], clamp(ivec2(floor(bp + 0.5)), ivec2(0), bsize - 1), 0).xy;
		// One step refined: average the vector here with the one where that step lands. A
		// moving edge then splits between the two fields (lavapipe: best balance of camera
		// worst frame against the climb sequence).
		// A zero vector cannot move the lookup: a second fetch reads the same texel.
		if (v0 != vec2(0.0)) {
			vec2 b1 = bp - (u_t - 0.5) * 0.25 * v0;
			v0 = 0.5 * (v0 + texelFetch(s_samplers[2], clamp(ivec2(floor(b1 + 0.5)), ivec2(0), bsize - 1), 0).xy);
			bp -= (u_t - 0.5) * 0.25 * v0;
		}
	}
	ivec2 b0 = ivec2(floor(bp));
	vec2 fr = bp - vec2(b0);
	vec4 s00 = texelFetch(s_samplers[2], clamp(b0, ivec2(0), bsize - 1), 0);
	vec4 s10 = texelFetch(s_samplers[2], clamp(b0 + ivec2(1, 0), ivec2(0), bsize - 1), 0);
	vec4 s01 = texelFetch(s_samplers[2], clamp(b0 + ivec2(0, 1), ivec2(0), bsize - 1), 0);
	vec4 s11 = texelFetch(s_samplers[2], clamp(b0 + ivec2(1, 1), ivec2(0), bsize - 1), 0);
	vec4 sel;
	// Only a threshold is needed: avoid three square roots per output pixel.
	vec2 d10 = s00.xy - s10.xy, d01 = s00.xy - s01.xy, d11 = s00.xy - s11.xy;
	float spread2 = max(max(dot(d10, d10), dot(d01, d01)), dot(d11, d11));
	if (spread2 < 4.0) {
		sel = mix(mix(s00, s10, fr.x), mix(s01, s11, fr.x), fr.y);
	} else {
		// Motion boundary: choose per pixel among the four neighbouring block motions by
		// photometric agreement of the two sources, preferring the pixel's own block.
		vec4 cand[4] = vec4[4](s00, s10, s01, s11);
		int own = (fr.x < 0.5 ? 0 : 1) + (fr.y < 0.5 ? 0 : 2);
		float best = 1e9;
		sel = cand[own];
		for (int i = 0; i < 4; i++) {
			// The own block wins identical motion by its bias. Avoid two colour
			// reads for duplicates, common on clamped borders and straight edges.
			if (i != own && cand[i].xy == cand[own].xy)
				continue;
			vec2 v = cand[i].xy * sc;
			vec2 a_pos = vec2(p) - u_t * v;
			vec2 b_pos = vec2(p) + (1.0 - u_t) * v;
			// Clamped colour is not evidence of a match: use the pair's stored
			// residual where the two-sided photometric test is unavailable.
			float e = cand[i].w;
			if (edge_distance(a_pos, size) >= 0.0 && edge_distance(b_pos, size) >= 0.0) {
				vec3 a = kfg_tap(0, a_pos, size).rgb;
				vec3 b = kfg_tap(1, b_pos, size).rgb;
				e = dot(abs(a - b), vec3(1.0));
			}
			e -= i == own ? 0.02 : 0.0;
			if (e < best) {
				best = e;
				sel = cand[i];
			}
		}
	}
	vec2 v = sel.xy * sc;
	vec2 pa = vec2(p) - u_t * v;
	vec2 pb = vec2(p) + (1.0 - u_t) * v;
	// Out-of-frame samples: take the other side when only one is inside the image.
	float da = edge_distance(pa, size), db = edge_distance(pb, size);
	float w_b = sel.z;
	if (pair) {
		// Side ratio at mid-phase -> weight of B at this phase, then lean an unreliable match
		// towards the nearer frame rather than a ghost (as the per-phase selection did).
		float wa = (1.0 - u_t) * (1.0 - w_b), wb = u_t * w_b;
		w_b = wb / max(wa + wb, 1e-6);
		w_b = mix(w_b, u_t < 0.5 ? 0.0 : 1.0, smoothstep(0.10, 0.20, sel.w));
	}
	// Fade to the valid source over the reconstruction footprint, before clamp
	// would repeat its edge texel. This is continuous as motion crosses a border.
	if (da < db)
		w_b = mix(1.0, w_b, smoothstep(0.0, 2.0, da));
	else if (db < da)
		w_b *= smoothstep(0.0, 2.0, db);
	// A side with no weight is not sampled (occlusions, unreliable matches, frame edges).
	// Whole-pixel positions (static content, integer motion) need no resampling.
	vec4 ca = vec4(0.0), cb = vec4(0.0);
	if (w_b < 1.0)
		ca = fract(pa) == vec2(0.0) ? texelFetch(s_samplers[0], clamp(ivec2(pa), ivec2(0), size - 1), 0) : tap_sharp(0, pa, size);
	if (w_b > 0.0)
		cb = fract(pb) == vec2(0.0) ? texelFetch(s_samplers[1], clamp(ivec2(pb), ivec2(0), size - 1), 0) : tap_sharp(1, pb, size);
	vec3 c = mix(ca.rgb, cb.rgb, w_b);
	// Faint motion blur on fast motion only (a turn above ~10 px per game frame): two more
	// taps per side along the motion, up to 4 px long. Static and slow content (HUD, text,
	// slow turns) is untouched and costs nothing.
#ifdef KFG_EXPERIMENT_NO_BLUR
	const float blur = 0.0;
#else
	const float speed2 = dot(sel.xy, sel.xy);
	const float blur = speed2 > 172.265625 ? min((sqrt(speed2) - 10.0) * 0.08, 4.0) : 0.0;  // analysis pixels
#endif
	if (blur > 0.25) {
		vec2 o = normalize(v) * (0.5 * blur) * sc;
		vec3 sa = w_b < 1.0 ? kfg_tap(0, pa - o, size).rgb + kfg_tap(0, pa + o, size).rgb : vec3(0.0);
		vec3 sb = w_b > 0.0 ? kfg_tap(1, pb - o, size).rgb + kfg_tap(1, pb + o, size).rgb : vec3(0.0);
		c = (2.0 * c + 0.5 * mix(sa, sb, w_b)) * (1.0 / 3.0);
	}
	if ((u_flags & KFG_FLAG_DEBUG_MARKER) != 0 && p.x < 24 && p.y < 24) {
		// Optical-verification marker: brightness encodes the phase (camera tests only).
		c = vec3(u_t);
	}
	imageStore(dst, p, vec4(c, 1.0));
}
