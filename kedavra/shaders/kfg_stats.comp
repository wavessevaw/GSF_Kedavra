// Pair statistics and scene-cut test, one workgroup writing one texel.
// Slots: 0 = luma A (level 2), 1 = luma B (level 2), 2 = flow (level 2).
// Output: x = cut (0/1), y = fraction of blocks badly explained by motion,
//         z = mean motion-compensated error, w = mean zero-motion error.
// With KFG_FLAG_GLOBAL: slot 0 = coarsest flow; writes the forward and backward camera
// motion as affine fields (see camera() and kfg_global_at) to texels 1 to 3.
#version 450
#extension GL_GOOGLE_include_directive : require
#include "kfg_common.glsl"

layout(local_size_x = 256) in;

shared float s_bad[256];
shared float s_mc[256];
shared float s_zero[256];
shared float s_inc[256];

#define GBINS 64          // 8-pixel bins, +-256 pixels
shared uint s_hist[GBINS * GBINS];
shared uint s_best[256];
shared vec3 s_acc[256];

// Dominant translation: the mode of an 8-pixel histogram, refined by mean shift.
vec2 dominant(uint lid, ivec2 size, bool backward)
{
	for (uint i = lid; i < uint(GBINS * GBINS); i += 256u)
		s_hist[i] = 0u;
	barrier();
	for (int i = int(lid); i < size.x * size.y; i += 256) {
		vec4 f = texelFetch(s_samplers[0], ivec2(i % size.x, i / size.x), 0);
		vec2 v = backward ? f.zw : f.xy;
		ivec2 b = ivec2(floor(v / 8.0 + 0.5)) + GBINS / 2;
		if (all(greaterThanEqual(b, ivec2(0))) && all(lessThan(b, ivec2(GBINS))))
			atomicAdd(s_hist[b.y * GBINS + b.x], 1u);
	}
	barrier();
	// Arg-max: count in the high bits, bin index in the low 12.
	uint best = 0u;
	for (uint i = lid; i < uint(GBINS * GBINS); i += 256u)
		best = max(best, (s_hist[i] << 12) | i);
	s_best[lid] = best;
	barrier();
	for (uint s = 128u; s > 0u; s >>= 1) {
		if (lid < s)
			s_best[lid] = max(s_best[lid], s_best[lid + s]);
		barrier();
	}
	uint bin = s_best[0] & 4095u;
	vec2 centre = (vec2(float(bin % uint(GBINS)), float(bin / uint(GBINS))) - float(GBINS / 2)) * 8.0;
	barrier();
	// Two mean-shift steps with a shrinking window: an aliased match on repeating texture
	// sits a period away and must not pull the mean.
	vec2 r = centre;
	for (int it = 0; it < 2; it++) {
		float win = it == 0 ? 6.0 : 3.0;
		vec3 acc = vec3(0.0);
		for (int i = int(lid); i < size.x * size.y; i += 256) {
			vec4 f = texelFetch(s_samplers[0], ivec2(i % size.x, i / size.x), 0);
			vec2 v = backward ? f.zw : f.xy;
			if (all(lessThanEqual(abs(v - r), vec2(win))))
				acc += vec3(v, 1.0);
		}
		s_acc[lid] = acc;
		barrier();
		for (uint s = 128u; s > 0u; s >>= 1) {
			if (lid < s)
				s_acc[lid] += s_acc[lid + s];
			barrier();
		}
		if (s_acc[0].z > 0.0)
			r = s_acc[0].xy / s_acc[0].z;
		barrier();
	}
	return r;
}

// Camera motion as a translation plus a zoom, v(d) = c + s d over the offset d from the
// image centre: a turn is mostly the translation, walking forward or up stairs is the zoom,
// where the steps near the camera move fastest. One zoom for both axes keeps it measurable
// on slanted, repeating texture (steps), where a free affine field follows the aliases.
// Grown from the dominant translation by refitting to the vectors within a shrinking distance
// of the current model, so objects, the HUD and aliased matches stay outliers. The histogram
// is free by now and holds the 7 sums per thread. Stored as an affine field (see
// kfg_global_at): centre motion c, gradient (s h.x, 0, 0, s h.y) per half image.
#define NSUM 7u
void camera(uint lid, ivec2 size, bool backward, out vec2 c, out vec4 m)
{
	c = dominant(lid, size, backward);
	float zoom = 0.0;
	const vec2 half_size = 0.5 * vec2(u_fullSize);
	const vec2 scale = vec2(u_fullSize) / vec2(size);
	const float wins[4] = float[4](8.0, 6.0, 4.0, 3.0);
	for (int it = 0; it < 4; it++) {
		float a[NSUM];
		for (uint k = 0u; k < NSUM; k++)
			a[k] = 0.0;
		for (int i = int(lid); i < size.x * size.y; i += 256) {
			ivec2 q = ivec2(i % size.x, i / size.x);
			vec4 f = texelFetch(s_samplers[0], q, 0);
			vec2 v = backward ? f.zw : f.xy;
			vec2 d = (vec2(q) + 0.5) * scale - half_size;
			if (any(greaterThan(abs(v - c - zoom * d), vec2(wins[it]))))
				continue;
			d /= half_size.x;  // keep the sums in range
			a[0] += 1.0; a[1] += d.x; a[2] += d.y; a[3] += dot(d, d);
			a[4] += v.x; a[5] += v.y; a[6] += dot(d, v);
		}
		for (uint k = 0u; k < NSUM; k++)
			s_hist[lid * NSUM + k] = floatBitsToUint(a[k]);
		barrier();
		for (uint s = 128u; s > 0u; s >>= 1) {
			if (lid < s)
				for (uint k = 0u; k < NSUM; k++)
					s_hist[lid * NSUM + k] = floatBitsToUint(uintBitsToFloat(s_hist[lid * NSUM + k]) + uintBitsToFloat(s_hist[(lid + s) * NSUM + k]));
			barrier();
		}
		float t[NSUM];
		for (uint k = 0u; k < NSUM; k++)
			t[k] = uintBitsToFloat(s_hist[k]);
		barrier();
		const float n = t[0];
		if (n < 0.1 * float(size.x * size.y))
			break;  // too few blocks follow the camera: keep the last model
		mat3 g = mat3(n, 0.0, t[1], 0.0, n, t[2], t[1], t[2], t[3]);
		// The inliers must spread around their mean for a zoom to be measurable.
		if (t[3] - (t[1] * t[1] + t[2] * t[2]) / n > 0.02 * n) {
			vec3 r = inverse(g) * vec3(t[4], t[5], t[6]);
			c = r.xy;
			zoom = clamp(r.z / half_size.x, -0.25, 0.25);  // at most 25% per frame
		} else {
			c = vec2(t[4], t[5]) / n;
			zoom = 0.0;
		}
	}
	m = vec4(zoom * half_size.x, 0.0, 0.0, zoom * half_size.y);
}

// Hold out a ring of texture around each landmark from the centre-pixel residual.
// Local flow can belong to an adjacent depth layer. Try the neighbouring hypotheses,
// but accept a displacement only if it predicts both the centre and its surroundings.
bool continuedPatch(uint lane, ivec2 size)
{
	ivec2 tile = ivec2(int(lane / 16u) % 4, int(lane / 64u));
	ivec2 sub = ivec2(int(lane % 4u), int(lane / 4u) % 4);
	ivec2 p = ivec2((vec2(tile * 4 + sub) + 0.5) * vec2(size) / 16.0);
	const ivec2 offsets[5] = ivec2[5](ivec2(0), ivec2(-3,-1), ivec2(1,-3), ivec2(3,1), ivec2(-1,3));
	if (any(lessThan(p, ivec2(3))) || any(greaterThan(p, size - 4))) return false;
	float a[5], still = 0.0, lo = 1.0, hi = 0.0;
	for (int i = 0; i < 5; ++i) {
		a[i] = texelFetch(s_samplers[0], p + offsets[i], 0).r;
		still += abs(a[i] - texelFetch(s_samplers[1], p + offsets[i], 0).r);
		lo = min(lo, a[i]);
		hi = max(hi, a[i]);
	}
	if (hi - lo < 0.045 || still < 0.12) return false;
	for (int j = 0; j < 5; ++j) {
		vec2 v = texelFetch(s_samplers[2], p + offsets[j], 0).xy * 0.25;
		vec2 q = vec2(p) + v;
		if (dot(v, v) < 0.5 || any(lessThan(q, vec2(3))) || any(greaterThan(q, vec2(size - 4)))) continue;
		float diff = 0.0;
		for (int i = 0; i < 5; ++i)
			diff += abs(a[i] - kfg_tap(1, q + vec2(offsets[i]), size).r);
		if (diff < min(0.15, 0.43 * still)) return true;
	}
	return false;
}

// Estimate normal motion of narrow, locally straight contours. A block can follow
// the background behind a wire even when both endpoints show the wire clearly.
vec3 sampleColor(int side, ivec2 p) {
	return side == 0 ? texelFetch(s_samplers[3], p, 0).rgb : texelFetch(s_samplers[4], p, 0).rgb;
}
float ridgeResponse(int side, ivec2 p, ivec2 axis, vec3 c) {
	float a = kfg_luma(c - sampleColor(side, p - 2 * axis));
	float b = kfg_luma(c - sampleColor(side, p + 2 * axis));
	return min(abs(a), abs(b)) * (a*b > 0.0 ? sign(a) : 0.0);
}
void ridgeMotion(uint lid, ivec2 grid, bool measure) {
	const int radius = 80;
	const int bins = 2*radius+1;
	for (int i=int(lid); i<2*bins*9; i+=256) s_hist[i]=0u;
	barrier();
	if (measure) {
		ivec2 sz = textureSize(s_samplers[3],0);
		for (int dim=0; dim<2; ++dim) {
			ivec2 axis = dim == 0 ? ivec2(1,0) : ivec2(0,1);
			int width=sz[dim], height=sz[1-dim];
			// Bound sampling at high dock resolutions. Stagger scanline origins
			// to avoid sampling only one parity of a thin repeating structure.
			int columns = min(width, 512);
			for(int i=int(lid); i<8*columns; i+=256) {
				int row = i/columns;
				int col = ((i%columns)*width + (row*width/8)%width)/columns;
				ivec2 p=axis*col+axis.yx*((2*row+1)*height/16);
				if(any(lessThan(p,ivec2(4))) || any(greaterThan(p,sz-5))) continue;
				vec3 c=sampleColor(0,p);
				float strength=ridgeResponse(0,p,axis,c);
				if(abs(strength)<0.14 || length(sampleColor(0,p+3*axis.yx)-c)>0.085) continue;
				ivec2 g=min(ivec2((vec2(p)+0.5)*vec2(grid)/vec2(sz)),grid-1);
				vec2 flow=texelFetch(s_samplers[2],g,0).xy * vec2(sz)/(4.0*vec2(grid));
				ivec2 centre=p+ivec2(round(flow));
				float best=1.0; int delta=0;
				for(int j=-24; j<=24; ++j) {
					ivec2 q=centre+j*axis;
					if(any(lessThan(q,ivec2(4))) || any(greaterThan(q,sz-5))) continue;
					vec3 dest=sampleColor(1,q);
					float e=length(dest-c);
					if(e>0.09) continue;
					float other=ridgeResponse(1,q,axis,dest);
					if(strength*other<=0.0 || abs(other)<0.12 || length(sampleColor(1,q+3*axis.yx)-dest)>0.085) continue;
					float score=e+0.16*abs(strength-other)+0.0015*float(abs(j));
					if(score<best) { best=score; delta=q[dim]-p[dim]; }
				}
				if(best<1.0 && abs(delta)<=radius) {
					int index = dim*bins + delta + radius;
					atomicAdd(s_hist[index],1u);
					int tone = clamp(int(kfg_luma(c)*8.0),0,7);
					atomicAdd(s_hist[2*bins+8*index+tone],1u);
				}
			}
		}
	}
	barrier();
	if(lid==0u) {
		vec4 result=vec4(0);
		for(int dim=0; dim<2; ++dim) {
			uint best=0u, total=0u;
			int peak=0;
			for(int j=0; j<bins; ++j) {
				uint votes=s_hist[dim*bins+j];
				total+=votes;
				if(votes>best) { best=votes; peak=j; }
			}
			if(best>=12u && best*4u >= total) {
				result[dim]=float(peak-radius);
				uint mask=0u;
				for(int k=0; k<8; ++k)
					if(s_hist[2*bins+8*(dim*bins+peak)+k]*10u>=best)
						mask |= 1u << k;
				result[2+dim]=float(mask);
			}
		}
		imageStore(dst,KFG_CONTOUR_TEXEL,result);
	}
}

void main()
{
	uint lid = gl_LocalInvocationID.x;
	if ((u_flags & KFG_FLAG_GLOBAL) != 0) {
		vec2 cf, cb;
		vec4 mf, mb;
		camera(lid, u_srcSize, false, cf, mf);
		camera(lid, u_srcSize, true, cb, mb);
		if (lid == 0u) {
			imageStore(dst, KFG_GLOBAL_TEXEL, vec4(cf, cb));
			imageStore(dst, KFG_GLOBAL_TEXEL + ivec2(1, 0), mf);
			imageStore(dst, KFG_GLOBAL_TEXEL + ivec2(2, 0), mb);
			// Finite difference of consecutive interval-average velocities. The
			// position correction at phase t is t(1-t) times the stored coefficient.
			vec2 camera = 0.5 * (cf - cb);
			vec2 rawChange = vec2(0.0);
			vec2 curve = vec2(0.0);
			if (u_t > 0.0 && texelFetch(s_samplers[1], ivec2(0), 0).x < 0.5) {
				vec4 prev = texelFetch(s_samplers[1], KFG_GLOBAL_TEXEL, 0);
				vec2 predicted = 0.5 * (prev.xy - prev.zw) * u_t;
				vec2 delta = camera - predicted;
				float agreement = 1.0 - smoothstep(3.0, 12.0, length(cf + cb) + u_t * length(prev.xy + prev.zw));
				float change = length(delta) / max(4.0, max(length(camera), length(predicted)));
				rawChange = delta * agreement;
				vec2 last = texelFetch(s_samplers[1], KFG_CURVE_TEXEL, 0).xy;
				float aligned = dot(last, rawChange) / max(1.0, length(last) * length(rawChange));
				float consistent = smoothstep(0.25, 0.80, aligned) * smoothstep(1.5, 4.0, length(last));
				curve = consistent * delta * (u_t / (1.0 + u_t)) * agreement * smoothstep(0.12, 0.35, change);
			}
			imageStore(dst, KFG_CURVE_TEXEL, vec4(rawChange, curve));
		}
		return;
	}
	ivec2 size = u_srcSize;
	float bad = 0.0, mc = 0.0, zero = 0.0, inc = 0.0, n = 0.0;
	for (int i = int(lid); i < size.x * size.y; i += 256) {
		ivec2 q = ivec2(i % size.x, i / size.x);
		vec2 f = texelFetch(s_samplers[2], q, 0).xy * 0.25; // pixels -> level-2 texels
		float a = texelFetch(s_samplers[0], q, 0).r;
		float e_mc = abs(a - kfg_tap(1, vec2(q) + f, size).r);
		float e_zero = abs(a - texelFetch(s_samplers[1], q, 0).r);
		// Field coherence: a block whose vector differs from its right or lower neighbour's
		// by more than one texel (4 px). Motion is smooth almost everywhere; between two
		// unrelated pictures the search returns scattered best matches.
		vec2 f1 = texelFetch(s_samplers[2], min(q + ivec2(1, 0), size - 1), 0).xy * 0.25;
		vec2 f2 = texelFetch(s_samplers[2], min(q + ivec2(0, 1), size - 1), 0).xy * 0.25;
		inc += (length(f1 - f) > 1.0 || length(f2 - f) > 1.0) ? 1.0 : 0.0;
		mc += e_mc;
		zero += e_zero;
		bad += e_mc > 0.1 ? 1.0 : 0.0;
		n += 1.0;
	}
	s_bad[lid] = bad;
	s_mc[lid] = mc;
	s_zero[lid] = zero;
	s_inc[lid] = inc;
	barrier();
	for (uint s = 128u; s > 0u; s >>= 1) {
		if (lid < s) {
			s_bad[lid] += s_bad[lid + s];
			s_mc[lid] += s_mc[lid + s];
			s_zero[lid] += s_zero[lid + s];
			s_inc[lid] += s_inc[lid + s];
		}
		barrier();
	}
	{
		float total = float(size.x * size.y);
		float frac_bad = s_bad[0] / total;
		float mean_mc = s_mc[0] / total, mean_zero = s_zero[0] / total;
		// A cut is a pair that motion does not explain: many blocks stay badly matched, or
		// the best motion removes little of the frame difference. GSF 1.5: "little" alone
		// also matched slow pans (2-3 px/frame: small frame difference, interpolation
		// residual). A residual over the noise floor now needs a scattered field (pans and
		// turns: up to 25 % of blocks off their neighbours; a cut between two textures: 63 %),
		// or to be most of the frame difference (a cut to or from a flat picture).
		// The scattered field also needs the residual to be a fair share of the difference
		// (1.4.0's test): a fast turn past things at many depths (96 px per frame) has a
		// field as scattered as a cut's, but motion removes four fifths of the difference.
		float incoherent = s_inc[0] / total;
		bool unexplained = mean_mc > 0.012 && ((incoherent > 0.4 && mean_mc > 0.26 * mean_zero) || mean_mc > 0.85 * mean_zero);
		bool cut = frac_bad > u_cutThreshold || unexplained;
        // Only reconsider a scattered field with substantial overall motion compensation.
        // Flat cuts, high bad-match ratios and unexplained global changes retain the hard hold.
        if ((u_flags & (KFG_FLAG_PQ | KFG_FLAG_SCRGB)) == 0 && unexplained && frac_bad <= u_cutThreshold && mean_mc < 0.6 * mean_zero) {
            // Each of the sixteen screen regions votes independently.
            s_best[lid] = continuedPatch(lid, size) ? 1u : 0u;
            barrier();
            if ((lid % 16u) == 0u) {
                uint votes = 0u;
                for (uint k = 0u; k < 16u; ++k) votes += s_best[lid+k];
                s_hist[lid / 16u] = votes >= 3u ? 1u : 0u;
            }
            barrier();
            if (lid == 0u) {
                uint regions = 0u;
                for (uint k = 0u; k < 16u; ++k) regions += s_hist[k];
                cut = regions < 9u;
            }
        }
        if (lid == 0u)
		imageStore(dst, ivec2(0, 0), vec4(float(cut), frac_bad, s_mc[0] / total, s_zero[0] / total));
		// Broadcast the decision before reusing workgroup scratch.
		if (lid == 0u) s_best[0] = uint(cut);
		barrier();
		bool measure = s_best[0] == 0u && mean_zero > 0.025 && (u_flags & (KFG_FLAG_PQ | KFG_FLAG_SCRGB)) == 0;
		ridgeMotion(lid, size, measure);
	}
}
